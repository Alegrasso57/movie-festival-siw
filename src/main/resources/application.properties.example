# Copia questo file in application.properties e inserisci i tuoi valori reali.
# application.properties (con le credenziali vere) NON deve mai essere committato.

spring.datasource.url=jdbc:postgresql://HOST:5432/postgres
spring.datasource.username=INSERISCI_USERNAME
spring.datasource.password=INSERISCI_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080

spring.jpa.properties.hibernate.generate_statistics=true

# Chiave segreta per firmare i JWT (almeno 256 bit / 32 caratteri). Generane una nuova, es. con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
jwt.secret=INSERISCI_UNA_CHIAVE_SEGRETA_LUNGA_ALMENO_32_CARATTERI
jwt.expiration-ms=86400000
